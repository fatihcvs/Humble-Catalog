# Shell scripts must keep LF endings: a CRLF checkout turns the shebang
# into "#!/usr/bin/env bash\r", which POSIX shells refuse to run.
*.sh text eol=lf

# PowerShell is fine either way, but pin CRLF so Windows tooling is happy.
*.ps1 text eol=crlf

# Git hooks cannot carry a .sh extension -- the filename IS the hook name --
# so they need the LF rule spelled out separately or the rule above misses
# them and a CRLF checkout breaks the shebang on macOS and Linux.
scripts/hooks/* text eol=lf
